# CurioLab platform backend environment (template)
# Copy to the host secret store. Never commit real values.
# This file lists names and shapes only.
#
# Audited against actual `process.env` usage on 2026-07-26 (see deploy.md).
# Vars marked [not yet read] exist for a feature that isn't wired into the
# live path yet; keep them out of the secret store until that lands, rather
# than provisioning credentials nothing consumes.

# --- Database ---
# The app connects as the restricted curiolab_app role, never the owner.
# Neon: use the POOLED connection string here. Mechanism B's withRlsContext
# uses SET LOCAL inside an explicit transaction, which transaction-mode
# pooling handles safely — the unpooled string is not required.
DATABASE_URL=postgres://curiolab_app:CHANGE_ME@HOST:5432/curiolab
# Read-only connection for analytics tooling (Mechanism A). Role exists
# (packages/db/migrations/0002_roles.sql) but no in-repo tooling reads this
# var yet — provision it anyway, since analytics access should never share
# the app's role.
DATABASE_URL_ANALYTICS=postgres://curiolab_analytics:CHANGE_ME@HOST:5432/curiolab

# --- Field-level encryption ---
# Base64, 256-bit key. Encrypts mentor-student DM message bodies at rest
# (packages/runtime/src/field-crypto.ts). Read fresh from env at use time,
# never logged, never written to a committed .env. Required once
# MENTOR_DM_ENABLED is flipped on; harmless to provision before then.
DM_ENCRYPTION_KEY=CHANGE_ME

# --- Email (Resend) ---
# Setting RESEND_API_KEY does NOT make email deliverable by itself. Before the
# first real invite, the sending domain (the transactional subdomain below,
# not the root domain) must have SPF, DKIM, and DMARC records configured in
# DNS and verified in the Resend dashboard, or messages will be dropped or
# spam-foldered regardless of how correct this file is. See "Resend domain
# and DNS" in deploy.md for the exact steps and the webhook-signature caveat.
RESEND_API_KEY=CHANGE_ME
RESEND_WEBHOOK_SECRET=CHANGE_ME
# The actual sender address the app sends from (invites, receipts, Stage-2
# tokens). Put this on the dedicated transactional subdomain, never the
# newsletter subdomain.
APPLY_FROM_EMAIL=notify@notify.example.org
# Where a submitted application and other director-facing notices are sent.
DIRECTOR_NOTIFY_EMAIL=director@example.org
# [not yet read] Reserved for when newsletter sending is wired onto its own
# subdomain, isolated from the transactional one above.
MAIL_NEWSLETTER_FROM=news@mail.example.org

# --- Public app URL ---
# Used to build links inside emails and portal redirects.
APP_URL=https://platform.example.org
NEXT_PUBLIC_SITE_URL=https://platform.example.org

# --- Object storage (Cloudflare R2, private) ---
# [not yet read] R2StorageAdapter (packages/app/src/storage.ts) is currently
# a stub that throws on every call — no S3-compatible client is installed.
# Do not provision real credentials until that adapter is implemented; see
# deploy.md's gate section.
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=curiolab-documents

# --- Billing (Stripe) ---
STRIPE_WEBHOOK_SECRET=CHANGE_ME
# No secret key is needed here for read-only status; add only if the backend
# ever initiates charges, which the current design does not.

# --- REVIEW-GATED feature flags ---
# All four default to false/off in code. Each is blocked on a specific,
# different sign-off — check the linked one before flipping, not just
# "has counsel looked at this generally."
#
# Blocked on: the L1-L5 legal review (docs/platform/open-questions.md).
# Governs: the public-publication consent-grant publish gate + the
# notify-and-object window only (packages/app/src/config.ts).
CONSENT_GRANT_LEDGER_ENFORCED=false
# Blocked on: the L1-L5 legal review (docs/platform/open-questions.md).
# Governs: whether an ineligible mentor/teaching membership is denied
# student-facing capabilities and auto-revoked by the eligibility sweep.
MENTOR_ELIGIBILITY_ENFORCED=false
# Blocked on: the design-doc Part A/B board ratification + counsel sign-off
# + abuse/molestation insurance (docs/platform/plans/mentor-student-dm-design.md).
# This is the highest-risk flag here: it enables adult-to-minor messaging.
MENTOR_DM_ENABLED=false
# Blocked on: counsel sign-off specifically (not the general legal review).
# Enabling this REVERSES the platform's "a student is not directly
# contactable" posture and makes a minor directly contactable by email
# (packages/app/src/config.ts:300-304). Building the mechanism imposes no
# obligation to enable it.
STUDENT_NOTIFICATION_EMAIL_ENABLED=false

# --- Runtime ---
NODE_ENV=production

# --- One-time admin bootstrap (not a steady-state secret) ---
# Only needed for the single `npm run seed:admin` invocation
# (docs/platform/deploy/bootstrap-admin.md). Set at seed time, then unset —
# do not leave the password in the long-lived secret store.
# CURIOLAB_BOOTSTRAP_EMAIL=founder@acuriolab.org
# CURIOLAB_BOOTSTRAP_NAME=Ada Founder
# CURIOLAB_BOOTSTRAP_PASSWORD=CHANGE_ME
# CURIOLAB_BOOTSTRAP_DOB=1970-01-01
